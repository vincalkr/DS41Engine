# The AMD/HIP port's local run artifacts (docs/ds4/AMD_HIP_NOTES.md): the Engram sources and tables, the prompt
# dumps and the HF cache are data (hundreds of GB), not source.  local/*.py and local/*.json are kept.
/local/engram-src/
/local/engram/
/local/prompts/
/local/*.bin
!/local/rank-1017.bin
/local/*.ids
/.hf-cache/
/.run/

# our launcher is part of this branch (the run-*.sh files the setup generates are not)
!/run.sh
