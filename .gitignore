/local/calib-q2/stats-corpus/
/local/calib-q2/stats-circles/
/local/routes-chat/
/local/routes-1017/
/local/stats-chat-merged/

# the per-run logs of the measurement sweeps stay local; the summaries and the reference tokens are kept
/local/sweep-*/*
!/local/sweep-*/summary.txt
!/local/sweep-*/ref-*.ids

# Measurement and debugging output stays local (2026-10-21): rank builds' merged stats, evaluation runs (only each
# run's score.json is kept), logit / hidden-state dumps, profiler CSVs, attempt patches, core dumps
/local/*.stats/
/local/eval-lucebox/*/*
!/local/eval-lucebox/*/score.json
/local/eval-lucebox/eval.out
*.dump
*.f32
/local/**/*.csv
/local/*.patch
core
core.[0-9]*
