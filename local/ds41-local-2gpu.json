{
 "exe": "local/ds41-engine-local.sh",
 "args": [
  "-m",
  "models/V41-GSQ/V41-GSQ.gguf",
  "--backend",
  "cuda",
  "--experts",
  "gpu",
  "--rank",
  "local/rank-gsq-mixed.bin",
  "--threads",
  "12",
  "--ctx",
  "262144",
  "--stop",
  "1",
  "--kv-q8",
  "--prompt-batch",
  "8192",
  "--arena-gib",
  "75",
  "--engram",
  "models/engram/layers14:models/engram/layers1",
  "--route-bias",
  "0",
  "--route-bias-file",
  "0",
  "--arena-skip-vram",
  "--arena-adapt",
  "--vram-margin",
  "0.5",
  "--peer-device",
  "1",
  "--pf-b",
  "0",
  "--pcie",
  "0",
  "--dump-routes",
  "local/routes-chat"
 ],
 "env": {
  "STRATA_NO_LARGEPAGES": "1",
  "GGML_NO_BACKTRACE": "1",
  "DS41_EXE": "build-hip-fused/ds41_generate",
  "STRATA_PRESTAGE_GIB": "1.5",
  "STRATA_PRESTAGE_MIN": "512",
  "STRATA_SERVE_PASS_BIAS": "0",
  "STRATA_TEXT_LOG": "local/v41-text.log",
  "STRATA_PF_NO_DUMMY": "1",
  "STRATA_PEER_GIB": "22",
  "HIP_VISIBLE_DEVICES": "0,1",
  "STRATA_PEER_ADAPT": "1",
  "STRATA_PEER_ADAPT_INFLIGHT": "8",
  "STRATA_PEER_ADAPT_WIN": "16",
  "STRATA_SERVE_PASS_BATCH": "1",
  "STRATA_VRAM_BG": "1",
  "STRATA_DENSE_NOCONT": "1",
  "STRATA_DENSE_ALIAS": "1",
  "STRATA_DENSE_REQUANT": "q6_K",
  "STRATA_SERVE_STEP_MAX": "256"
 },
 "cwd": ".",
 "tokenizer": "models/V41-GSQ/tokenizer",
 "model_name": "deepseek-v4.1-flash-gsq-hip",
 "log": "local/serve-engine.log",
 "port": 8150,
 "backend": "hip",
 "gpu": 0,
 "sampling": {
  "temperature": 0.8,
  "top_p": 0.95,
  "repetition_penalty": 1.1,
  "penalty_last_n": 256
 },
 "reasoning_loop_recovery": "recover",
 "reasoning_budget_tokens": 1024,
 "reasoning_close_retry": true
}