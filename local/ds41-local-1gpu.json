{
  "exe": "local/ds41-engine-local.sh",
  "args": [
    "-m",
    "models/rco-iq2xxs/DeepSeek-V4.1-Flash-1017-GSQ-RCO-IQ2_XXS-00001-of-00004.gguf",
    "--backend",
    "cuda",
    "--experts",
    "gpu",
    "--rank",
    "local/rank-q2.bin",
    "--threads",
    "12",
    "--ctx",
    "262144",
    "--stop",
    "1",
    "--kv-q8",
    "--prompt-batch",
    "8192",
    "--arena-gib",
    "80",
    "--engram",
    "models/engram-1017/layers14:models/engram-1017/layers1",
    "--route-bias",
    "0",
    "--route-bias-file",
    "0",
    "--arena-skip-vram",
    "--arena-adapt",
    "--vram-margin",
    "0.5",
    "--pf-b",
    "0",
    "--pcie",
    "0",
    "--dump-routes",
    "local/routes-rco",
    "--conversation-cache-mib",
    "4096",
    "--conversation-disk",
    "local/conv-cache-rco",
    "--conversation-disk-gib",
    "32"
  ],
  "env": {
    "STRATA_NO_LARGEPAGES": "1",
    "GGML_NO_BACKTRACE": "1",
    "DS41_EXE": "build-hip-fused/ds41_generate",
    "STRATA_PRESTAGE_GIB": "1.5",
    "STRATA_PRESTAGE_MIN": "512",
    "STRATA_SERVE_PASS_BIAS": "0",
    "STRATA_TEXT_LOG": "local/v41-text.log",
    "STRATA_PF_NO_DUMMY": "1",
    "STRATA_SERVE_PASS_BATCH": "1",
    "STRATA_VRAM_BG": "1",
    "STRATA_DENSE_NOCONT": "1",
    "STRATA_DENSE_ALIAS": "1",
    "STRATA_DENSE_REQUANT": "q6_K",
    "STRATA_SERVE_STEP_MAX": "96",
    "STRATA_SUM_ZEROCOPY": "1",
    "DS41_META": "local/rco-iq2xxs-meta/meta.gguf"
  },
  "cwd": ".",
  "tokenizer": "models/rco-iq2xxs/tokenizer",
  "model_name": "deepseek-v4.1-flash-1017-rco-iq2xxs",
  "log": "local/serve-engine.log",
  "port": 8150,
  "backend": "hip",
  "gpu": 0,
  "sampling": {
    "temperature": 0.8,
    "top_p": 0.95,
    "repetition_penalty": 1.1,
    "penalty_last_n": 256
  },
  "reasoning_loop_recovery": "recover",
  "reasoning_budget_tokens": 1024,
  "reasoning_close_retry": true,
  "reasoning_budget_by_effort": {
    "low": 1024,
    "high": 4096,
    "max": 0
  }
}
