{
 "exe": "local/ds41-engine-local.sh",
 "args": [
  "-m",
  "/run/media/vincenzo/SSD NVME SAMSUNG/ds4/gguf/DeepSeek-V4.1-Flash-Q2.gguf",
  "--backend",
  "cuda",
  "--experts",
  "gpu",
  "--rank",
  "models/V41-GSQ/rank.bin",
  "--threads",
  "24",
  "--ctx",
  "262144",
  "--stop",
  "1",
  "--kv-q8",
  "--prompt-batch",
  "12288",
  "--arena-gib",
  "75",
  "--engram",
  "models/engram/layers14:models/engram/layers1"
 ],
 "env": {
  "STRATA_NO_LARGEPAGES": "1",
  "GGML_NO_BACKTRACE": "1",
  "STRATA_DSPARK_DEPTH": "4",
  "STRATA_DSPARK_KEEP": "tools/v41/serve/dspark_expert_counts.txt:64",
  "DS41_EXE": "build-hip-fused/ds41_generate",
  "STRATA_PRESTAGE_GIB": "1.5",
  "GGML_CUDA_DISABLE_GRAPHS": "1",
  "STRATA_SERVE_PASS_BIAS": "0",
  "STRATA_TEXT_LOG": "local/v41-text-q2.log",
  "STRATA_RB_MARGIN": "1"
 },
 "cwd": ".",
 "tokenizer": "models/V41-GSQ/tokenizer",
 "model_name": "deepseek-v4.1-flash-q2-hip",
 "log": "local/serve-engine-q2.log",
 "port": 8151,
 "backend": "hip",
 "gpu": 0,
 "sampling": {
  "temperature": 0.8,
  "top_p": 0.95,
  "repetition_penalty": 1.1,
  "penalty_last_n": 256
 },
 "reasoning_loop_recovery": "recover",
 "reasoning_budget_tokens": 192,
 "reasoning_close_retry": true
}
